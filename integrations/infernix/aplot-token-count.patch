+// Modified for Aplot Control LLM: exact Chat Completions token counting.
+void HttpServer::handle_chat_input_tokens(const httplib::Request& req, httplib::Response& res) {
+    try {
+        RequestLimits limits;
+        limits.default_max_tokens = options_.default_max_tokens;
+        const auto request = parse_chat_completion_request(parse_json_body(req), limits);
+        validate_openai_model(request.model, public_model_id_);
+        const int tokens = service_->count_prompt_tokens(request.generation,
+            [&req] { return client_disconnected(req); });
+        res.set_content(nlohmann::json{{"input_tokens", tokens}}.dump(), "application/json");
+    } catch (const ApiException& exception) {
+        write_openai_error(res, exception.error());
+    } catch (const std::exception& exception) {
+        ApiError error;
+        error.status = 500;
+        error.message = exception.what();
+        write_openai_error(res, error);
+    }
+}
