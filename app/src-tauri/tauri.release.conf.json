{
  "build": {
    "beforeBuildCommand": "npm run build && npm run installer:ui"
  },
  "bundle": {
    "licenseFile": "../../LICENSE",
    "resources": {
      "../artifacts/legal/": "legal/",
      "installer/": "installer/"
    },
    "targets": [
      "nsis"
    ],
    "windows": {
      "allowDowngrades": false,
      "nsis": {
        "template": "installer/installer.nsi",
        "installerHooks": "installer/components.nsh",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "languages": [
          "Russian",
          "English"
        ],
        "displayLanguageSelector": true
      }
    }
  }
}
